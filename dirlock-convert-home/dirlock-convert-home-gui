#!/bin/sh
#
# SPDX-License-Identifier: BSD-3-Clause
#
# Simple kdialog-based frontend to dirlock. The actual tasks are
# performed by dirlock-convert-home (run through pkexec), which in
# turn talks to the dirlock daemon using the D-Bus API.

set -eu

TITLE="Home directory encryption"

# dirlock needs TPM 2.0, which always has a resource manager node. With
# one, the home directory may be protected by a PIN instead of a password.
if [ -e /dev/tpmrm0 ]; then
    have_tpm=true
    secret="password or PIN"
else
    have_tpm=false
    secret="password"
fi

# Temporary directory for the recovery key and error messages
tmpdir=$(mktemp -d -p "${XDG_RUNTIME_DIR:-/tmp}" "dirlock.XXXXXX")
trap 'rm -rf "$tmpdir"' INT EXIT

# Run the dirlock-convert-home helper script
run_helper() {
    pkexec /usr/lib/dirlock/dirlock-convert-home "$@" 2> "$tmpdir/err"
}

# Report an error message generated by the helper script
fail() {
    msg=$(cat "$tmpdir/err")
    kdialog --title "$TITLE" --error "${msg:-Unexpected error}"
    exit 1
}

# Ask for confirmation to perform an action based on the state
# of the home directory. Succeeds if the user accepts the action.
confirm_action() {
    kdialog --title "$TITLE" --yes-label "$1" --no-label "Close" --yesno "$2"
}

# Start the service that shows progress information on the desktop.
# Nothing happens if it is already running.
show_progress() {
    systemctl --user start dirlock-session-progress.service || true
}

# Encrypt the home directory, or resume an interrupted encryption
encrypt() {
    # Ignored when resuming: the helper reuses the protector it started with
    ptype=password
    if [ "$1" = resume ]; then
        pass=$(kdialog --title "$TITLE" --password \
            "Enter the $secret that you chose when the encryption started.") || exit 0
    else
        kdialog --title "$TITLE" --warningcontinuecancel \
"You are about to encrypt your home directory.

THIS FEATURE IS EXPERIMENTAL

This will make an encrypted copy of your files and then replace the
original ones with the encrypted versions. This process needs enough
free space on disk and it can take a long time.

The encryption will start immediately and you can keep using the
desktop session, but the encryption will not be complete until you log
out and wait for the process to finish.

You will see a progress bar on the login screen, and you will be
notified once your data is encrypted. After that, you can use your
system normally with the $secret that you are about to choose.

It is recommended to open this tool again when your home is encrypted
in order to set up a recovery key.

No data is lost if the machine is rebooted before the encryption is
finished. After a reboot, you can use this tool again to resume or
cancel the process." || exit 0

        # Enable encryption on the filesystem first, as this may require a reboot
        # https://github.com/gregkh/linux/commit/40554d1221e3d2ff2e0d192b74a05d89eb3620e7
        if ! run_helper enable-fs-encryption; then
            msg=$(cat "$tmpdir/err")
            if expr "X$msg" : "XEncryption support has just been enabled" > /dev/null; then
                kdialog --title "$TITLE" --msgbox \
                        "This filesystem did not have encryption support, so it has just been
enabled now.

IMPORTANT: you need to reboot the machine now and restart the process
afterwards by opening this tool again.

Due to a bug in the Linux kernel, please don't try to encrypt your
data before rebooting the machine."
                exit 0
            else
                kdialog --title "$TITLE" --error \
                        "There was an error when trying to enable encryption support
on the filesystem:

$msg"
                exit 1
            fi
        fi

        if $have_tpm; then
            rc=0
            kdialog --title "$TITLE" --yes-label "Use the TPM" \
                --no-label "Password only" --yesnocancel \
"How do you want to protect your home directory?

- Use the TPM: the key is protected by this computer's security
chip. You need to enter a PIN to unlock your data and the TPM will
lock you out after several failed authentication attempts. This makes
it safer than a regular password and allows you to have a shorter
PIN. Note that the PIN can contain any character, not just numbers.
Using the TPM means that your files can only be unlocked on this
machine: if the TPM gets reset or the disk is moved to another
computer, you will need a recovery key to have access to your data. You
can set up a recovery key at any time once the encryption is ready.

- Password only: your files are only protected with your password and an
attacker with access to this machine can try to break it without
limits. Because of that, using a stronger password is recommended.

Note that the TPM support in this tool is functional but still basic
and under development. If unsure, you can always start using the TPM
later without having to re-encrypt your data." || rc=$?
            case $rc in
                0) ptype=tpm2 ;;
                1) ;;
                *) exit 0 ;;
            esac
        fi
        if [ "$ptype" = tpm2 ]; then credential=PIN; else credential=password; fi

        pass=$(kdialog --title "$TITLE" --password \
            "Choose a $credential for your home directory.") || exit 0
        pass2=$(kdialog --title "$TITLE" --password "Repeat the $credential") || exit 0
        if [ "$pass" != "$pass2" ]; then
            kdialog --title "$TITLE" --error "The ${credential}s do not match."
            exit 1
        fi
    fi

    out=$(printf '%s\n' "$pass" |
          run_helper convert --password-stdin --protector-type "$ptype") || fail
    if [ "$ptype" = tpm2 ]; then
        out="$out

Once the encryption is complete, open this tool again to add a recovery
key. Without one, your files are lost if this computer's TPM is reset."
    fi

    show_progress
    kdialog --title "$TITLE" --msgbox "$out"
}

recovery_add() {
    pass=$(kdialog --title "$TITLE" --password \
        "Enter your encryption $secret.") || exit 0

    printf '%s\n' "$pass" | run_helper recovery-add --password-stdin > "$tmpdir/key" || fail

    {
        echo "This is the recovery key of your home directory. The key is NOT case-sensitive."
        echo
        echo "For convenience, the next window will display it as a QR code."
        echo
        cat "$tmpdir/key"
        echo
        echo "Write it down and keep it safe: it won't be shown again."
    } > "$tmpdir/key.txt"
    # Wide enough that no line is wrapped
    kdialog --title "$TITLE" --textbox "$tmpdir/key.txt" 800 300

    tr -d '\n' < "$tmpdir/key" | qrencode -s 10 -o "$tmpdir/key.png"
    kdialog --title "$TITLE" --imgbox "$tmpdir/key.png"
}

recovery_remove() {
    kdialog --title "$TITLE" --continue-label "Remove" --warningcontinuecancel \
"If you remove the recovery key and then forget your $secret,
there is no other way to get your files back.

Note that you can always generate a new recovery key in the future
using your $secret.

Do you really want to remove the recovery key?" || exit 0

    out=$(run_helper recovery-remove) || fail
    kdialog --title "$TITLE" --msgbox "$out"
}

stop_encryption() {
    out=$(run_helper stop) || fail
    kdialog --title "$TITLE" --msgbox "$out"
}

interrupted() {
    rc=0
    kdialog --title "$TITLE" --yes-label "Resume" --no-label "Discard" \
        --cancel-label "Close" --warningyesnocancel \
"The encryption of your home directory was interrupted.

You can resume it, or discard it and keep your files unencrypted, as they
are now." || rc=$?

    case $rc in
        0) encrypt resume ;;
        1)
            out=$(run_helper discard) || fail
            kdialog --title "$TITLE" --msgbox "$out"
            ;;
        *) exit 0 ;;
    esac
}

# This is the beginning of the script: check the current status of the
# encryption (using the helper) and show the appropriate action.
state=$(run_helper status) || fail

case $state in
    unencrypted)
        confirm_action "Encrypt..." "Your home directory is not encrypted." || exit 0
        encrypt new
        ;;
    ongoing)
        show_progress
        confirm_action "Stop" "Your home directory is being encrypted.

If you stop it, the encryption can be resumed or discarded later.
Your files are not affected." || exit 0
        stop_encryption
        ;;
    deferred)
        show_progress
        confirm_action "Stop" "All your files have been copied. The encryption of your
home directory will be completed when you log out.

If you stop it, the encryption can be resumed or discarded later.
Your files are not affected." || exit 0
        stop_encryption
        ;;
    interrupted)
        interrupted
        ;;
    encrypted)
        confirm_action "Add recovery key" "Your home directory is encrypted, but it has no recovery key.

A recovery key lets you get your files back if you forget your $secret." || exit 0
        recovery_add
        ;;
    encrypted-recovery)
        confirm_action "Remove recovery key..." "Your home directory is encrypted, and it has a recovery key." || exit 0
        recovery_remove
        ;;
    *)
        kdialog --title "$TITLE" --error \
            "Your home directory cannot be managed with this tool ($state)."
        exit 1
        ;;
esac
